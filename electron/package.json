{
  "name": "sampleforge",
  "version": "1.0.0",
  "description": "AI-Powered Audio Sample Manager — multilingual semantic search for sound libraries",
  "main": "main.js",
  "author": "Marcosblancarg",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "python-shell": "^5.0.0"
  },
  "build": {
    "appId": "com.sampleforge.app",
    "productName": "SampleForge",
    "icon": "../assets/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "python.exe",
          "pythonw.exe",
          "python3.dll",
          "python312.dll",
          "vcruntime140*.dll",
          "DLLs/**/*",
          "Lib/**/*",
          "Scripts/**/*"
        ]
      },
      {
        "from": "..",
        "to": ".",
        "filter": [
          "main.py",
          "config.py",
          "requirements.txt",
          "core/**/*",
          "ui/**/*",
          "utils/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SampleForge",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "packElevateHelper": false
    },
    "asar": false,
    "compression": "maximum",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music"
    }
  }
}
